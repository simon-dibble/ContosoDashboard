@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject ITaskService TaskService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Tasks - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>My Tasks</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> New Task
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>Status</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">All</option>
                <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                <option value="@Models.TaskStatus.InProgress">In Progress</option>
                <option value="@Models.TaskStatus.Completed">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>Priority</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">All</option>
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
                <option value="@TaskPriority.Critical">Critical</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">No tasks found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Project</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@task.Title</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@task.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                                    <option value="@Models.TaskStatus.InProgress">In Progress</option>
                                    <option value="@Models.TaskStatus.Completed">Completed</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No due date</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@task.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (taskDocuments.TryGetValue(task.TaskId, out var attachedDocuments) && attachedDocuments.Count > 0)
                                {
                                    <ul class="list-unstyled mb-1 small">
                                        @foreach (var attachedDocument in attachedDocuments)
                                        {
                                            <li><a href="@($"/documents/{attachedDocument.DocumentId}")">@attachedDocument.Title</a></li>
                                        }
                                    </ul>
                                }
                                <div class="input-group input-group-sm mt-1" style="max-width: 13rem">
                                    <input class="form-control" type="number" placeholder="Document ID"
                                           @bind="documentIds[task.TaskId]" />
                                    <button class="btn btn-outline-secondary" @onclick="() => AttachDocumentAsync(task.TaskId)">Attach</button>
                                </div>
                                <div class="mt-1" style="max-width: 13rem">
                                    <InputFile OnChange="@(args => UploadTaskDocumentAsync(task, args))" />
                                </div>
                                @if (attachmentMessages.TryGetValue(task.TaskId, out var attachmentMessage))
                                {
                                    <small class="text-muted">@attachmentMessage</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TaskItem>? tasks;
    private string filterStatus = "";
    private string filterPriority = "";
    private int currentUserId = 0;
    private readonly Dictionary<int, int?> documentIds = new();
    private readonly Dictionary<int, string> attachmentMessages = new();
    private readonly Dictionary<int, List<Document>> taskDocuments = new();

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
        taskDocuments.Clear();
        if (tasks is not null)
        {
            foreach (var task in tasks)
                taskDocuments[task.TaskId] = await DocumentService.GetTaskDocumentsAsync(task.TaskId);
        }
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private void ShowCreateTaskModal()
    {
        // TODO: Implement modal dialog for creating tasks
    }

    private void ViewTaskDetails(int taskId)
    {
        // TODO: Navigate to task details or show modal
    }

    private async Task AttachDocumentAsync(int taskId)
    {
        if (!documentIds.TryGetValue(taskId, out var documentId) || !documentId.HasValue)
        {
            attachmentMessages[taskId] = "Enter a document ID.";
            return;
        }
        var result = await DocumentService.AttachToTaskAsync(documentId.Value, taskId);
        attachmentMessages[taskId] = result.Succeeded ? "Document attached." : result.Error ?? "The document could not be attached.";
        if (result.Succeeded)
            taskDocuments[taskId] = await DocumentService.GetTaskDocumentsAsync(taskId);
    }

    private async Task UploadTaskDocumentAsync(TaskItem task, InputFileChangeEventArgs args)
    {
        var file = args.File;
        try
        {
            await using var stream = file.OpenReadStream(25 * 1024 * 1024);
            var outcome = (await DocumentService.UploadAsync(file.Name, null, "General", null, task.ProjectId,
                new[] { new DocumentUploadRequest(file.Name, file.ContentType, stream, file.Size) })).Single();
            if (outcome.Succeeded && outcome.Document is not null)
            {
                var attachResult = await DocumentService.AttachToTaskAsync(outcome.Document.DocumentId, task.TaskId);
                attachmentMessages[task.TaskId] = attachResult.Succeeded ? "Document uploaded and attached." : attachResult.Error ?? "Uploaded but could not be attached.";
                if (attachResult.Succeeded)
                    taskDocuments[task.TaskId] = await DocumentService.GetTaskDocumentsAsync(task.TaskId);
            }
            else
            {
                attachmentMessages[task.TaskId] = outcome.Error ?? "The document could not be uploaded.";
            }
        }
        catch
        {
            attachmentMessages[task.TaskId] = "The document could not be uploaded.";
        }
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}
